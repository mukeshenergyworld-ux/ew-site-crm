4VM#NW1":["CEFIONTECT","WATER_SAVING"],"WH172AAT":["WATER_SAVING"]},"techDict":{"EWATERPLUS":{"n":"EWATER+","e":"Sprays the wand, bowl and underside of the seat with electrolysed water, keeping them clean with less need for harsh chemicals."},"CEFIONTECT":{"n":"CEFIONTECT","e":"Ultra-smooth glaze that resists dirt and build-up, so the ceramic stays clean longer with less water and chemicals."},"PREMIST":{"n":"PREMIST","e":"A film of water is sprayed before use so waste does not stick to the bowl."},"TORNADO_FLUSH":{"n":"TORNADO FLUSH","e":"360° swirling flush that cleans every spot of the bowl using less water."},"RIMLESS":{"n":"RIMLESS","e":"No rim, so there is no place for waste and germs to hide, and the bowl is much easier to clean."},"AIR_IN_WONDER_WAVE":{"n":"AIR-IN WONDER-WAVE","e":"Air-rich water gives a comfortable wash and better cleansing with less water."},"LINEARCERAM":{"n":"LINEARCERAM","e":"Basin material that allows a very thin design yet is twice as strong as standard fireclay."},"WATER_SAVING":{"n":"WATER SAVING","e":"Designed to use less water on every flush, efficient and kind to the environment."},"AUTO_FUNCTIONS":{"n":"AUTO FUNCTIONS","e":"Built-in sensor-activated automatic functions."},"HEATED_SEAT":{"n":"HEATED SEAT","e":"As you approach, the seat quickly warms to a comfortable temperature."},"DEODORIZER":{"n":"DEODORIZER","e":"Automatic deodorising inside the bowl during and right after use removes odours."},"WARM_AIR_DRYING":{"n":"WARM AIR DRYING","e":"Warm air dryer works with the water spray for a fresh, dry feeling."},"SOFT_FLOW":{"n":"SOFT FLOW","e":"Gentle, soft streams of water for a calm, soothing feel."},"COMFORT_GLIDE":{"n":"COMFORT GLIDE","e":"Internal valve designed for a light touch, giving smooth and reliable operation."},"ECO_CAP":{"n":"ECO CAP","e":"Mixes air with water to cut water use while still giving an effective wash."},"ECO_POWER":{"n":"ECO POWER","e":"Touchless faucet that makes its own electricity from the water flow, so no external power is needed."},"MIST_SPA":{"n":"MIST SPA","e":"Mist infused with ultra-fine bubbles, gentle on the skin."},"CALMING_SHAWL":{"n":"CALMING SHAWL","e":"Overhead spray holes arranged in an arc so the face and hair stay dry."},"WARM_SPA":{"n":"WARM SPA","e":"A gentle stream of warm water that wraps the body, relaxing and restful."},"WARM_SPA_2":{"n":"WARM SPA","e":"A gentle stream of warm water that wraps the body, relaxing and restful."},"GYROSTREAM":{"n":"GYROSTREAM","e":"Rotating nozzle with a pulsating stream for a massaging effect."},"COMFORT_WAVE":{"n":"COMFORT WAVE","e":"Large, dense, pleasing droplets on the scalp for a luxurious, comfortable shower."},"COMFORT_WAVE_2":{"n":"COMFORT WAVE","e":"Large, dense, pleasing droplets on the scalp for a luxurious, comfortable shower."},"COMFORT_WAVE_3":{"n":"COMFORT WAVE","e":"Large, dense, pleasing droplets on the scalp for a luxurious, comfortable shower."},"INTENSE_WAVE":{"n":"INTENSE WAVE","e":"A stimulating, vigorous stream, ideal for tired muscles or starting the day."},"INTENSE_WAVE_2":{"n":"INTENSE WAVE","e":"A stimulating, vigorous stream, ideal for tired muscles or starting the day."},"ACTIVE_WAVE":{"n":"ACTIVE WAVE","e":"A stimulating spray that refreshes body and mind."},"INTENSE_WAVEPLUS":{"n":"INTENSE WAVE+","e":"Stronger water pressure for an even more intense, revitalising flow."},"INTENSE_WAVEPLUS_2":{"n":"INTENSE WAVE+","e":"Stronger water pressure for an even more intense, revitalising flow."},"SAFETY_THERMO":{"n":"SAFETY THERMO","e":"Shape-memory-alloy thermostatic valve adjusts temperature quickly for a safer shower."},"HEAT_PROTECT":{"n":"HEAT PROTECT","e":"Hot-water paths are covered with a layer of cold water to prevent burns."},"MINI_UNIT":{"n":"MINI UNIT","e":"Same compact exterior size for all concealed shower valves, for a balanced look."},"ZERO_DIMENSION":{"n":"ZERO DIMENSION","e":"Weightless bathing posture that takes stress off the joints for deep relaxation."},"HYDROHANDS":{"n":"HYDROHANDS","e":"Deep water massage that feels like real hands kneading tired muscles."},"RECLINE_COMFORT":{"n":"RECLINE COMFORT","e":"Reclined position that supports neck and back for deep relaxation."}}}